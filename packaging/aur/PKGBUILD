# AUR PKGBUILD — Safa (beta). Builds from the linux-x64-cpu tarball.
# No cuda tarball ships (>2 GiB cap): NVIDIA users run
# `safa setup --device cuda` (or install.sh --variant cuda) afterwards.
# Replace <owner>/<sha256> at release; names come from release-info.toml.
pkgname=safa
pkgver=0.1.0
pkgrel=1
pkgdesc="Clean audio and video recordings locally — noise removal, transcription (صفا)"
arch=('x86_64')
url="https://github.com/<owner>/safa"
license=('MIT')
depends=('ffmpeg')
source=("Safa-${pkgver}-linux-x64-cpu.tar.gz::https://github.com/<owner>/safa/releases/download/v${pkgver}/Safa-${pkgver}-linux-x64-cpu.tar.gz")
sha256sums=('<sha256-linux-cpu>')

package() {
    install -dm755 "$pkgdir/opt/safa"
    cp -a "Safa-${pkgver}-linux-x64-cpu/." "$pkgdir/opt/safa/"
    chmod +x "$pkgdir/opt/safa/python/bin/"* "$pkgdir/opt/safa/tools/ffmpeg/bin/"* 2>/dev/null || true
    # System package → installed mode: portable.txt would pin data
    # inside the root-owned /opt tree; the wrapper sets the XDG dir.
    rm -f "$pkgdir/opt/safa/portable.txt"

    install -dm755 "$pkgdir/usr/bin"
    cat > "$pkgdir/usr/bin/safa" <<'EOF'
#!/bin/sh
: "${XDG_DATA_HOME:=$HOME/.local/share}"
export SOUND_SYSTEM_DATA_DIR="$XDG_DATA_HOME/safa-data"
cd /opt/safa
exec /opt/safa/python/bin/python3 -m backend.launcher "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/safa"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/safa.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Safa (صفا)
Comment=Clean audio and video recordings on your own computer
Exec=/usr/bin/safa
Terminal=true
Categories=AudioVideo;
EOF
}
