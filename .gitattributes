# POSIX scripts must keep LF on every checkout (Windows autocrlf would
# break the shebang / sh parsing in tarballs and Docker builds).
*.sh text eol=lf
start.command text eol=lf
packaging/aur/PKGBUILD text eol=lf
packaging/homebrew/*.rb text eol=lf
# M10d POSIX packaging dirs — extensionless wrappers (safa, AppRun, Safa),
# deb control/maintainer scripts, .desktop entries, rpm spec, flatpak
# manifest/metainfo, macOS plist all parse with LF semantics.
packaging/linux/** text eol=lf
packaging/appimage/** text eol=lf
packaging/rpm/** text eol=lf
packaging/flatpak/** text eol=lf
packaging/macos/** text eol=lf
