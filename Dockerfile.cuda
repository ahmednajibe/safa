# Dockerfile.cuda — Safa CUDA image (M10c §9.17).
#   docker build -f Dockerfile.cuda -t safa:cuda .
#   docker run --rm --gpus all -p 127.0.0.1:8790:8790 -v safa-data:/data safa:cuda
#
# Same layout as the CPU Dockerfile; the cu124 extra pulls the CUDA wheels
# through uv sources, and the base image is nvidia/cuda for the driver
# libraries torch links at runtime.

FROM node:22-bookworm-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS runtime
ARG EXTRA=cu124
ENV PYTHONUTF8=1 \
    SOUND_SYSTEM_PORT=8790 \
    SOUND_SYSTEM_BIND_HOST=0.0.0.0 \
    SOUND_SYSTEM_IN_CONTAINER=1 \
    SOUND_SYSTEM_DATA_DIR=/data

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Exact pin matching the dev env's uv — never a floating tag.
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /usr/local/bin/
# Single python source: uv-managed 3.11 installed OUTSIDE /root so the
# non-root user (uid 10001) can read/execute it.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python
RUN uv python install 3.11 && chmod -R a+rX /opt/uv-python

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY backend/ backend/
COPY scripts/prefetch_models.py scripts/prefetch_models.py
RUN UV_PYTHON=3.11 uv sync --frozen --no-dev --extra "$EXTRA" \
    && uv cache clean

COPY --from=frontend /build/frontend/dist frontend/dist

RUN useradd --create-home --uid 10001 safa \
    && mkdir -p /data && chown safa:safa /data
USER safa
VOLUME ["/data"]
EXPOSE 8790

HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
    CMD ["/app/.venv/bin/python", "-c", "import urllib.request,os;urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('SOUND_SYSTEM_PORT','8790')+'/api/health',timeout=4)"]

CMD ["uv", "run", "--frozen", "--no-sync", "python", "-m", "uvicorn", \
     "backend.main:app", "--host", "0.0.0.0", "--port", "8790"]
